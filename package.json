{
  "name": "hydragit",
  "displayName": "HydraGit",
  "description": "The git panel IntelliJ has, inside VS Code. No paywall.",
  "version": "0.1.0",
  "publisher": "vkushnarenko",
  "license": "MIT",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/latte-incognito/hydragit.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["SCM Providers"],
  "activationEvents": [
    "onView:hydragit.mainView",
    "onView:hydragit.sidebarView",
    "onCommand:hydragit.open"
  ],
  "main": "./extension/out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "hydragit.open",
        "title": "HydraGit: Open",
        "icon": "images/icon.png"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "hydragit",
          "title": "HydraGit",
          "icon": "images/icon-tight.png"
        }
      ],
      "panel": [
        {
          "id": "hydragit-panel",
          "title": "HydraGit",
          "icon": "images/icon-tight.png"
        }
      ]
    },
    "views": {
      "hydragit": [
        {
          "id": "hydragit.sidebarView",
          "name": "HydraGit",
          "type": "tree"
        }
      ],
      "hydragit-panel": [
        {
          "id": "hydragit.mainView",
          "name": "HydraGit",
          "type": "webview"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "hydragit.sidebarView",
        "contents": "Opening HydraGit in the bottom panel…"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./extension/tsconfig.json",
    "watch": "tsc -watch -p ./extension/tsconfig.json",
    "reinstall": "make package && code --install-extension hydragit-0.1.0.vsix"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.0"
  }
}