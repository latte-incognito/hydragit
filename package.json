{
  "name": "hydragit",
  "displayName": "HydraGit",
  "description": "The git panel IntelliJ has, inside VS Code. No paywall.",
  "version": "0.2.0",
  "publisher": "vkushnarenko",
  "license": "MIT",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/latte-incognito/hydragit.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "SCM Providers"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onStartupFinished"
  ],
  "main": "./extension/out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "hydragit.showVersionInfo",
        "title": "HydraGit: Show Version Info"
      },
      {
        "command": "hydragit.openLogs",
        "title": "HydraGit: Open Logs Folder"
      },
      {
        "command": "hydragit.fileHistory",
        "title": "HydraGit: File History"
      },
      {
        "command": "hydragit.selectionHistory",
        "title": "HydraGit: History for Selection"
      },
      {
        "command": "hydragit.toggleLineBlame",
        "title": "HydraGit: Toggle Line Blame"
      },
      {
        "command": "hydragit.copyCommitSha",
        "title": "HydraGit: Copy Commit SHA"
      },
      {
        "command": "hydragit.lineHistory",
        "title": "HydraGit: Line History"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "hydragit.fileHistory",
          "when": "!explorerResourceIsFolder",
          "group": "9_hydragit"
        }
      ],
      "editor/context": [
        {
          "command": "hydragit.fileHistory",
          "group": "9_hydragit"
        },
        {
          "command": "hydragit.selectionHistory",
          "when": "editorHasSelection",
          "group": "9_hydragit"
        },
        {
          "command": "hydragit.toggleLineBlame",
          "group": "9_hydragit"
        }
      ],
      "commandPalette": [
        {
          "command": "hydragit.copyCommitSha",
          "when": "false"
        },
        {
          "command": "hydragit.lineHistory",
          "when": "false"
        }
      ],
      "editor/title/context": [
        {
          "command": "hydragit.fileHistory",
          "group": "9_hydragit"
        }
      ]
    },
    "configuration": {
      "title": "HydraGit",
      "properties": {
        "hydragit.lineBlame.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show inline git blame on the current editor line (author, relative time, and commit summary). Toggle per-session with the \"HydraGit: Toggle Line Blame\" command."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "hydragit",
          "title": "HydraGit",
          "icon": "images/icon-tight.png",
          "command": "hydragit.revealAll"
        }
      ],
      "panel": [
        {
          "id": "hydragit-panel",
          "title": "HydraGit",
          "icon": "images/icon-tight.png"
        }
      ]
    },
    "views": {
      "hydragit": [
        {
          "id": "hydragit.sidebarView",
          "name": "HydraGit",
          "type": "webview"
        },
        {
          "id": "hydragit.badgeCarrier",
          "name": "Status",
          "when": "false"
        }
      ],
      "hydragit-panel": [
        {
          "id": "hydragit.mainView",
          "name": "HydraGit",
          "type": "webview"
        }
      ]
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run --reporter=verbose",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:e2e": "bash tests/fixtures/create-test-repo.sh /tmp/hydragit-test-repo && npx playwright test",
    "test:e2e:headed": "bash tests/fixtures/create-test-repo.sh /tmp/hydragit-test-repo && npx playwright test --headed",
    "compile": "tsc -p ./extension/tsconfig.json",
    "watch": "tsc -watch -p ./extension/tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.8.9",
    "@playwright/test": "^1.52.0",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.3.1",
    "@types/node": "^25.0.0",
    "@types/vscode": "^1.85.0",
    "@vitest/ui": "^4.1.2",
    "happy-dom": "^20.8.9",
    "jsdom": "^29.0.1",
    "prettier": "^3.8.1",
    "prettier-plugin-svelte": "^3.5.1",
    "svelte": "^5.55.0",
    "svelte-check": "^4.4.5",
    "tslib": "^2.8.1",
    "typescript": "^6.0.2",
    "vite": "^8.0.3",
    "vitest": "^4.1.2"
  }
}
