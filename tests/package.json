{
  "name": "hydragit-tests",
  "private": true,
  "description": "Playwright E2E tests for HydraGit VS Code extension",
  "scripts": {
    "create-repo": "bash fixtures/create-test-repo.sh /tmp/hydragit-test-repo",
    "test": "npm run create-repo && playwright test",
    "test:ui": "npm run create-repo && playwright test --ui",
    "test:headed": "npm run create-repo && playwright test --headed"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@vscode/test-electron": "^2.5.0"
  }
}
