# ── Source & dev files ────────────────────────────────────────────
.claude/
.idea/
.gitignore
.prettierignore
.prettierrc

# Docs / notes
CLAUDE.md
docs/
alpharius/

# Go source
cmd/
internal/
go.mod
go.sum
tools/

# Build config
Makefile
tsconfig.json
tsconfig.node.json
vite.config.ts
svelte.config.js
svelte.config.mjs

# Lint / CI config (dev + CI only, never used at runtime)
.golangci.yml
eslint.config.mjs
.github/

# Release tooling
scripts/

# ── TypeScript source (keep only compiled output) ──────────────────
# NB: do NOT add `!extension/out/**` — that negation re-includes the whole tree
# and overrides the test/source-map excludes below, leaking *.test.js into the
# package. Nothing here excludes extension/out/*.js, so the compiled JS ships
# without needing a negation.
extension/src/
extension/tsconfig.json
extension/node_modules/
**/*.ts

# Compiled test files + source maps (dev-only; never needed at runtime)
**/*.test.js
**/*.js.map

# ── Webview source (keep only compiled output) ─────────────────────
webview/src/
webview/node_modules/
webview/dist/

# ── Node modules ───────────────────────────────────────────────────
node_modules/

# ── Test artifacts & e2e output ────────────────────────────────────
playwright-report/
test-results/
tests/
playwright.config.ts
vitest.config.ts
vitest-setup.ts
**/*.test.ts
**/*.spec.ts

# ── Dev binary (runtime uses bin/<platform>-suffixed names) ────────
# Exact path, no wildcard — a trailing * would exclude the platform binaries.
bin/hydragit-server

# ── Dev docs / notes (not used at runtime) ─────────────────────────
documentation/
.vscode/
Readiness.md